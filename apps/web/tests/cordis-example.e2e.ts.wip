// Web e2e scenario: the shipped web-cordis example overlay must keep mounting
// over the real Web composition. The overlay's whole contribution is the
// model-facing Cordis toolset (`tool-cordis`) on top of the runner rows the
// dsh-web-app bundle already inserts; re-inserting a runner row the bundle
// owns is a duplicate loader entry id that fails the whole tree before the
// server binds — exactly the demo's "does not start, sessions are not
// created" failure. Booting the real tree with the example file through the
// same `--patch` seam `pnpm run demo:cordis` uses catches that class of
// breakage; a real chromium then clicks the sidebar's new-session control —
// the user-visible symptom — and the model tool row is asserted ACTIVE.
//
// The same boot also carries the overlay's tool-cordis WHILE a session runs
// the shipped `cordis` preset (which mounts tool-cordis again per session):
// the first-party inspect catalogs are process-global, so the second
// application must attach to the shared registration rather than fail the
// preset mount with `Host Cordis inspect provider "Service" is already
// registered` — the demo-plus-preset resume failure.
// Zero model calls: entity birth and composition switching only, no fixture.
import { fileURLToPath } from 'node:url'
import { FiberState } from '@deepseek-ai/cordis'
import { SessionId } from '@deepseek-ai/dsh-session'
import type { Browser, Page } from 'playwright'
import { chromium } from 'playwright'
import { afterAll, beforeAll, describe, expect, it } from 'vitest'
import { launchWebScaffold, watchConsole, type WebScaffold } from './scaffold.ts'
import { connectFreshWorkspace, newEnglishPage } from './support.ts'
// Empty type imports carry the apiProxy and loader Context merges the wire
// assertions below read, mirroring scaffold.ts's own merge-carrying imports.
import type {} from '@deepseek-ai/dsh-host-apiproxy'
import type {} from '@deepseek-ai/cordis-plugin-loader'

/** The example overlay `dsh web --patch examples/web-cordis/cordis.yml` mounts. */
const OVERLAY = fileURLToPath(new URL('../../../examples/web-cordis/cordis.yml', import.meta.url))

/** The host's answer for the one session the page connected, once listed. */
async function livePreset(baseUrl: string): Promise<string | undefined> {
  const response = await fetch(`${baseUrl}/api/session.list`, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({
      type: 'client-request', rpcId: 'cordis-example-live-preset', method: 'session.list', payload: {},
    }),
  })
  const body = await response.json() as {
    result: { value?: { items: { sessionId: string; agentPreset?: string }[] } }
  }
  return body.result.value?.items.at(-1)?.agentPreset
}

describe('web e2e: the web-cordis example overlay still mounts the Cordis toolset', () => {
  let scaffold: WebScaffold
  let browser: Browser
  let page: Page
  let tripwire: ReturnType<typeof watchConsole>

  beforeAll(async () => {
    scaffold = await launchWebScaffold({ extraOverlayPath: OVERLAY })
    browser = await chromium.launch()
    page = await newEnglishPage(browser)
    tripwire = watchConsole(page)
    await page.goto(scaffold.baseUrl, { waitUntil: 'load' })
    await page.waitForSelector('[class*="frame"]', { timeout: 30_000 })
  }, 120_000)

  afterAll(async () => {
    await browser?.close()
    await scaffold?.close()
  })

  it('creates a session from the browser new-session control', async () => {
    // The Sessions tree is the canonical sidebar-boot signal other lanes use.
    await page.getByRole('tree', { name: 'Sessions' }).waitFor({ timeout: 30_000 })
    // Two controls carry the label (the brand button and the sidebar's); the
    // sidebar's dedicated one owns the `newSession` css-module class.
    const control = page.locator('button[class*="newSession"]')
    await control.waitFor({ timeout: 15_000 })
    await control.click()
    // A blank session's composer is the visible proof the session was born;
    // waitFor resolves only on an attached, visible, stable element.
    const composer = page.locator('textarea').first()
    await composer.waitFor({ timeout: 15_000 })
  })

  it('switches the connected session onto the cordis preset with the overlay active', async () => {
    await connectFreshWorkspace(page, scaffold.workspaceCwd)
    await page.getByRole('button', { name: 'Standard mode' }).click()
    await page.getByRole('menuitem', { name: /Creator mode/ }).click()
    // The switch mounts the preset while the overlay's tool-cordis row is
    // already live: the shared inspect catalogs must attach, not collide.
    await expect.poll(() => livePreset(scaffold.baseUrl), { timeout: 15_000 }).toBe('cordis')
  })

  it('creates a preset-cordis session through the wire face with the overlay applied', async () => {
    const response = await scaffold.ctx.apiProxy.sessions.create({
      rpcId: 'cordis-example-create' as never,
      payload: { sessionId: SessionId('cordis-example'), cwd: scaffold.workspaceCwd, agentPreset: 'cordis' },
    })
    if (!response.result.ok) throw new Error(`session.create failed: ${response.result.error.message}`)
    expect(response.result.value.sessionId).toBe('cordis-example')
    expect(response.result.value.agentPreset).toBe('cordis')
  })

  it('activates the model-facing tool-cordis row the overlay adds', () => {
    const entry = [...scaffold.ctx.loader.entries()]
      .find(candidate => candidate.options.name === '@deepseek-ai/dsh-tool-cordis')
    expect(entry, 'tool-cordis row present in the composed tree').toBeDefined()
    expect(entry?.fiber?.state).toBe(FiberState.ACTIVE)
  })

  it('kept the browser console clean throughout', () => {
    expect(tripwire.pageErrors).toEqual([])
    expect(tripwire.warnings).toEqual([])
  })
})
